; Minimal Android deployment smoke test.
config_version=5

[application]

config/name="G McQueen"
config/description="A portrait flappy game featuring a tiny turbo pilot."
config/icon="res://assets/baby_head.png"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=360
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
