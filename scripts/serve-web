#!/usr/bin/env python3
"""Serve build/web locally, sending precompressed .gz files when accepted.

Usage: scripts/serve-web [--host 127.0.0.1] [--port 8096]
Put Tailscale Serve (or another HTTPS proxy) in front for phone access.
"""

import argparse
import functools
import http.server
import os
import pathlib

WEB_DIR = pathlib.Path(__file__).resolve().parent.parent / "build" / "web"


class Handler(http.server.SimpleHTTPRequestHandler):
    extensions_map = {
        **http.server.SimpleHTTPRequestHandler.extensions_map,
        ".wasm": "application/wasm",
        ".js": "text/javascript",
        ".pck": "application/octet-stream",
    }

    def send_head(self):
        path = pathlib.Path(self.translate_path(self.path))
        gz = path.with_name(path.name + ".gz")
        if path.is_file() and gz.is_file() and "gzip" in self.headers.get("Accept-Encoding", ""):
            try:
                f = open(gz, "rb")
            except OSError:
                return super().send_head()
            self.send_response(200)
            self.send_header("Content-Type", self.guess_type(str(path)))
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Content-Length", str(os.fstat(f.fileno()).st_size))
            self.end_headers()
            return f
        return super().send_head()

    def end_headers(self):
        # Rebuilds replace files in place, so always revalidate.
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Vary", "Accept-Encoding")
        super().end_headers()


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--host", default=os.environ.get("WEB_HOST", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("WEB_PORT", "8096")))
    args = parser.parse_args()
    handler = functools.partial(Handler, directory=str(WEB_DIR))
    with http.server.ThreadingHTTPServer((args.host, args.port), handler) as server:
        print(f"Serving {WEB_DIR} on http://{args.host}:{args.port}", flush=True)
        server.serve_forever()


if __name__ == "__main__":
    main()
